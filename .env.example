# ==============================================================================
# DocuFin AI - Environment Configuration Example
# Copy this file to .env and adjust values for your local or production environment.
# ==============================================================================

# Application Configuration
ENVIRONMENT=development
APP_NAME=DocuFin AI
APP_VERSION=0.1.0
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
ALLOWED_HOSTS=*
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & Secrets (Replace with securely generated random tokens in production)
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-in-production

# Database (PostgreSQL)
POSTGRES_USER=docufin_user
POSTGRES_PASSWORD=docufin_password_placeholder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docufin_db
# Async Database URL format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# If left empty, will be auto-constructed from POSTGRES_* parameters
DATABASE_URL=postgresql+asyncpg://docufin_user:docufin_password_placeholder@localhost:5432/docufin_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis URL format: redis://[:<password>@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Storage / Document Uploads (Phase 2+)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Frontend Configuration (Used by Vite during frontend build / dev)
VITE_API_BASE_URL=http://localhost:8000
